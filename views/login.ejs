<script type="module">
  import { setupValidation } from "/js/form-validation.js";
  import { loginSchema } from "/js/shared/authSchemas.js";
  const loginForm = document.querySelector(".login__form");
  setupValidation(loginForm, loginSchema);
</script>

<section class="section">
  <div class="container login">
    <h1 class="login__title">Inicia sesión en tu cuenta</h1>
    <form class="login__form" method="post" action="/login">
      <div class="input-field <%= locals.errors?.email ? 'input-field--error' : '' %>">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" autocomplete="email" required value="<%= locals.values?.email || '' %>" />
        <% if (locals.errors?.email) { %><span class="input-field__error"><%= locals.errors.email[0] %></span><% } %>
      </div>
      <div class="input-field <%= locals.errors?.password ? 'input-field--error' : '' %>">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" data-toggle-password />
        <% if (locals.errors?.password) { %><span class="input-field__error"><%= locals.errors.password[0] %></span><% } %>
      </div>
      <button type="submit" class="button button--lg login__submit">Iniciar sesión</button>
      <% if (locals.error) { %>
      <p class="login__error"><%= locals.error %></p>
      <% } %>
    </form>
  </div>
</section>