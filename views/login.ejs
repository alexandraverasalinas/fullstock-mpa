<script type="module" src="/js/toggle-password.js"></script>

<section class="section">
  <div class="container login">
    <h1 class="login__title">Inicia sesión en tu cuenta</h1>
    <form class="login__form" method="post" action="/login">
      <div class="input-field">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          autocomplete="email"
          required
          value="<%= locals.values?.email || '' %>"
        />
      </div>
      <div class="input-field">
        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          data-toggle-password
        />
      </div>
      <button type="submit" class="button button--lg login__submit">
        Iniciar sesión
      </button>
      <% if (locals.error) { %>
      <p class="login__error"><%= locals.error %></p>
      <% } %>
    </form>
  </div>
</section>
